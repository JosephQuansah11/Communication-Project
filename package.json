{
  "name": "quandrion-slide-master",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QuandrionSlideMaster - a collaborative presentation editor with PowerPoint import, Excel-style tables, multi-screen presenting and live WebSocket updates.",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "build:client": "vite build",
    "build:embed": "node scripts/embed-client.mjs",
    "build:exe": "npm run build:client && node scripts/embed-client.mjs && node scripts/build-exe.mjs",
    "sign:exe": "node scripts/sign-exe.mjs build/QuandrionSlideMaster.exe",
    "cert:new": "node scripts/make-signing-cert.mjs",
    "icons": "node scripts/make-pwa-icons.mjs",
    "e2e:mobile": "node e2e-mobile.mjs",
    "e2e:panels": "node e2e-panels.mjs",
    "e2e:transitions": "node e2e-transitions.mjs",
    "preview:app": "npm run build:client && node scripts/embed-client.mjs && node server/standalone.js --no-open",
    "start": "node scripts/start-server.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "import:check": "node scripts/check-import.mjs",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.1",
    "jszip": "^3.10.1",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "postject": "^1.0.0-alpha.6",
    "rcedit": "^5.0.2",
    "vite": "^5.4.11"
  }
}
